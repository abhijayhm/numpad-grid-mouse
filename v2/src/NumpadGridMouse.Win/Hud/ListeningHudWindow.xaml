<Window x:Class="NumpadGridMouse.Win.Hud.ListeningHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="24" Height="24"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        IsHitTestVisible="True"
        ToolTip="Arrow pointer active — Enter click · Enter×2 double-click · Shift+F10 right-click · Esc exit">
    <Ellipse Width="16" Height="16" Fill="#22C55E" Stroke="White" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Window>
